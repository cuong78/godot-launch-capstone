436: ''
437: '                                      {/* Alert box for rejected games */}'
438: "                                      {game.status?.toLowerCase() === 'rejected' && ("
439: '                                        <div className="p-3.5 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-500 space-y-1">'
440: '                                          <span className="font-bold flex items-center gap-1.5 text-xs"><AlertTriangle size={14} /> Game bị từ chối phê duyệt</span>'
441: '                                          <p className="text-[10px] leading-normal text-slate-500 dark:text-slate-400">Vui lòng kiểm tra địa chỉ email liên kết tài khoản của bạn để biết lý do từ chối chi tiết và các phản hồi từ ban quản trị hệ thống.</p>'
442: '                                        </div>'
443: '                                      )}'
444: ''
445: '                                      {/* Contract Status Card for Co-publishing or Full Acquisition */}'
446: '                                      {(() => {'
447: "                                        const contract = contracts.find(c => c.gameId === game.id && c.status !== 'cancelled');"
448: '                                        if (contract) {'
449: '                                          return ('
450: '                                            <div className="p-4 bg-slate-950/20 border border-slate-200 dark:border-slate-800 rounded-xl space-y-2.5">'
451: '                                              <span className="text-[10px] uppercase font-mono tracking-wider text-slate-500 font-bold flex items-center gap-1.5">'
452: '                                                <FileCheck size={12} className="text-sky-500" /> Hợp đồng phát hành'
453: '                                              </span>'
454: '                                              <div className="flex justify-between items-center text-xs">'
455: '                                                <span className="text-slate-500">Trạng thái:</span>'
456: '                                                <span className={`font-bold uppercase tracking-wider ${'
457: "                                                  contract.status === 'signed' ? 'text-emerald-500' : 'text-amber-500'"
458: '                                                }`}>'
459: "                                                  {contract.status === 'signed' ? 'Hoàn tất' : 'Chờ ký'}"
460: '                                                </span>'
461: '                                              </div>'
462: "                                              {contract.status === 'pending' && !contract.signedAtSeller && ("
463: '                                                <button'
464: '                                                  onClick={() => {'
465: '                                                    setSelectedContract(contract);'
466: "                                                    setViewerMode('sign-developer');"
467: '                                                    setIsViewerOpen(true);'
468: '                                                  }}'
469: '                                                  className="flex items-center justify-center gap-2 w-full py-2 px-4 bg-amber-400 hover:bg-amber-500 text-slate-950 font-bold rounded-lg text-xs transition-studio cursor-pointer"'
470: '                                                >'
471: '                                                  <PenTool size={14} /> Ký hợp đồng điện tử'
472: '                                                </button>'
473: '                                              )}'
474: "                                              {contract.status === 'pending' && contract.signedAtSeller && ("
475: '                                                <button'
476: '                                                  onClick={() => {'
477: '                                                    setSelectedContract(contract);'
478: "                                                    setViewerMode('view');"
479: '                                                    setIsViewerOpen(true);'
480: '                                                  }}'
481: '                                                  className="flex items-center justify-center gap-2 w-full py-2 px-4 bg-sky-500 hover:bg-sky-600 text-white font-bold rounded-lg text-xs transition-studio cursor-pointer"'
482: '                                                >'
483: '                                                  <Eye size={14} /> Xem chi tiết hợp đồng đã ký'
484: '                                                </button>'
485: '                                              )}'
486: "                                              {contract.status === 'signed' && ("
487: '                                                <button'
488: '                                                  onClick={() => {'
489: '                                                    setSelectedContract(contract);'
490: "                                                    setViewerMode('view');"
491: '                                                    setIsViewerOpen(true);'
492: '                                                  }}'
493: '                                                  className="flex items-center justify-center gap-2 w-full py-2 px-4 bg-emerald-500 hover:bg-emerald-450 text-white font-bold rounded-lg text-xs transition-studio cursor-pointer"'
494: '                                                >'
495: '                                                  <FileText size={14} /> Xem & Tải hợp đồng'
496: '                                                </button>'
497: '                                              )}'
498: '                                            </div>'
499: '                                          );'
500: '                                        }'
501: '                                        return null;'
502: '                                      })()}'
503: '                                    </div>'
504: ''
505: '                                    {/* Middle & Right Column: Screenshots & Video */}'
506: '                                    <div className="space-y-4 md:col-span-2 flex flex-col justify-between">'
507: '                                      <div className="space-y-2">'
508: '                                        <h4 className="text-[10px] uppercase font-mono tracking-wider text-slate-500 font-bold flex items-center gap-1.5">'
509: '                                          <Image size={12} className="text-sky-500" /> Ảnh chụp màn hình (Screenshots)'
510: '                                        </h4>'
