flowchart TB
  %% GodotLaunch System Architecture
  %% Presentation -> Application -> Database, with external integrations

  subgraph PT["Presentation Tier"]
    direction TB
    Web["Web Frontend\nReact 19 + TypeScript + Tailwind CSS v4"]
    Mobile["Mobile App\nFlutter"]
    AdminUI["Admin UI\nReact SPA"]
  end

  subgraph AT["Application Tier"]
    direction TB

    subgraph FE["Frontend Application Layer"]
      direction TB
      WebUI["Pages / Components\nReact routing, state, forms"]
      MobileUI["Screens / Widgets\nFlutter UI"]
    end

    subgraph BE["Backend Application Layer\nSpring Boot 4.0.6 / Java 21"]
      direction TB
      Controller["Controller Layer\nREST endpoints"]
      Service["Service Layer\nBusiness rules"]
      Repo["Repository Layer\nJPA / database access"]
      Security["Security Layer\nJWT, OAuth, filters"]
      Realtime["Realtime Layer\nWebSocket / Spring Messaging"]
      StorageRouter["Storage Router\nDynamic S3 / SeaweedFS routing"]
      Integration["Integration Layer\nGitHub, PayOS, Google, Email"]
      Domain["Domain Layer\nGames, marketplace, contracts, wallet, community"]

      Controller --> Service --> Repo
      Service --> Domain
      Service --> Security
      Service --> Realtime
      Service --> StorageRouter
      Service --> Integration
    end

    FaceService["Python Face Service\nFace verify, OCR, AI review, source analysis"]
  end

  subgraph DT["Database Tier"]
    direction TB
    PostgreSQL[("PostgreSQL 16\nFlyway V1-V14 schema")]
  end

  subgraph EXT["External Systems"]
    direction TB
    GitHub["GitHub\nOAuth / repo API / bot access"]
    Google["Google Services\nOAuth / reCAPTCHA / Vision OCR"]
    PayOS["PayOS\nCheckout / payment / payout"]
    Storage["AWS S3 / SeaweedFS\nObject storage"]
    SMTP["Email / SMTP Provider"]
    Stores["Google Play / App Store"]
  end

  Web -->|HTTP / JSON| Controller
  AdminUI -->|HTTP / JSON| Controller
  Mobile -->|HTTP / JSON| Controller
  WebUI --> Web
  MobileUI --> Mobile

  Web -->|WebSocket| Realtime
  Mobile -->|WebSocket| Realtime

  Controller -->|JDBC / ORM| PostgreSQL
  StorageRouter -->|S3 API / SeaweedFS API| Storage
  Integration -->|OAuth / repo API| GitHub
  Security -->|Token verification| Google
  Service -->|Checkout / payout requests| PayOS
  Service -->|Notifications / OTP| SMTP
  Service -->|Publish package metadata| Stores
  Service -->|HTTP| FaceService

  classDef tier fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#0f172a;
  classDef app fill:#93c5fd,stroke:#1d4ed8,stroke-width:1.5px,color:#0f172a;
  classDef ext fill:#ffffff,stroke:#64748b,stroke-dasharray: 5 4,color:#0f172a;
  classDef db fill:#f8fafc,stroke:#0f172a,stroke-width:1.5px,color:#0f172a;

  class PT,AT,DT,EXT tier;
  class Web,Mobile,AdminUI,WebUI,MobileUI,Controller,Service,Repo,Security,Realtime,StorageRouter,Integration,Domain,FaceService app;
  class GitHub,Google,PayOS,Storage,SMTP,Stores ext;
  class PostgreSQL db;
