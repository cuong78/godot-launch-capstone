@startuml Push-Game

title Push Game — 2.1 Marketplace (bán source) và 2.2 To Store (hợp đồng + publish Google Play API)

actor Developer as Dev
participant "Frontend" as FE
participant "GameController" as GameCtrl
participant "GitHubRepoServiceImpl" as GHRepo
participant "GitHub API" as GHAPI
participant "SourceProcessingClient\n(python service)" as SrcProc
participant "GameServiceImpl" as GameSvc
participant "SourceSnapshotRepository" as SnapRepo
participant "SourceCommitRepository" as CommitRepo
participant "AiReviewService" as AiSvc
participant "ContractServiceImpl" as ContractSvc
participant "GooglePlayPublishService" as GPSvc
participant "Google Play\nDeveloper API\n(androidpublisher)" as GPAPI
actor Admin

== Bước 0-1: Submit repo — public tự tải, private cần thêm bot collaborator ==

Dev -> FE: Nhập repo URL + branch, bấm Submit
FE -> GameCtrl: POST /api/games/{id}/submit-repo { repoUrl, branch }
GameCtrl -> GameSvc: submitGameRepo(gameId, repoUrl, branch, email)

GameSvc -> GHRepo: verifyOwnership(creator, repoUrl)
note right: Repo phải thuộc chính developer\n(chống submit repo người khác)
alt Không phải chủ repo
  GHRepo --> GameSvc: throw ACCESS_DENIED
  GameSvc --> FE: 403 lỗi
end

GameSvc -> GHRepo: checkAccess(repoUrl)

alt Repo PUBLIC
  GHRepo --> GameSvc: PUBLIC
  note right of GameSvc: Không cần collaborator gì thêm\n— hệ thống tự tải về ngay
else Repo PRIVATE, bot CHƯA là collaborator
  GHRepo --> GameSvc: PRIVATE_NO_ACCESS
  GameSvc --> FE: 400 REPO_NEEDS_BOT
  FE -> GameCtrl: GET /api/games/github-bot
  GameCtrl --> FE: botUsername
  FE --> Dev: Yêu cầu: "Add {botUsername} làm\ncollaborator repo private, rồi Submit lại"

  Dev -> GHAPI: (thủ công trên GitHub UI)\nAdd collaborator = bot, gửi invitation

  Dev -> FE: Bấm "Đã mời bot, thử lại"
  FE -> GameCtrl: POST /api/games/accept-bot { repoUrl }
  GameCtrl -> GameSvc: acceptBotInvitation(repoUrl, email)
  GameSvc -> GHRepo: acceptBotInvitation(repoUrl)
  GHRepo -> GHAPI: GET /user/repository_invitations (bot token)
  GHAPI --> GHRepo: list invitations
  GHRepo -> GHAPI: PATCH /user/repository_invitations/{id}\n(bot tự accept)
  GHAPI --> GHRepo: 204 accepted
  GHRepo --> GameCtrl: granted = true

  note right of GameCtrl #DDFFDD
    Bot đã vào collaborator -> hệ thống TỰ ĐỘNG
    clone lại ngay (gọi lại submitGameRepo), Dev
    KHÔNG cần nhập lại repo URL/branic từ đầu.
  end note
  GameCtrl -> GameSvc: submitGameRepo(gameId, repoUrl, branch, email)\n(tự động, không cần Dev bấm Submit lần 2)
else Repo PRIVATE, bot ĐÃ là collaborator sẵn (lần submit sau)
  GHRepo --> GameSvc: PRIVATE_GRANTED
end

GameSvc -> GHRepo: getCloneToken(repoUrl)
GHRepo --> GameSvc: token (null nếu public, bot token nếu private)

GameSvc -> SrcProc: process(repoUrl, token, branch)
SrcProc -> SrcProc: git clone
SrcProc -> SrcProc: ClamAV virus scan
SrcProc --> GameSvc: SourceProcessResult\n{clean, isGodotProject, commitSha, bundleHash,...}

alt Có mã độc (!clean)
  GameSvc -> GameSvc: game.status = rejected
  GameSvc -> SnapRepo: save(SourceSnapshot) — lưu cả bằng chứng malware
  GameSvc --> FE: 400 SOURCE_MALWARE_DETECTED
  FE --> Dev: Bị từ chối — phát hiện mã độc
end

alt Không phải Godot project
  GameSvc --> FE: 400 NOT_GODOT_PROJECT
  FE --> Dev: Bị từ chối — không phải project Godot hợp lệ
end

GameSvc -> GameSvc: game.githubVerifiedAt = now\ngame.status = pending
GameSvc -> SnapRepo: save(SourceSnapshot)\n(bundle zip + hash + virusClean)

note right of GameSvc #FFDDDD
  **Lưu lại TẤT CẢ commit** (yêu cầu 2.1) — không chỉ snapshot
  1 lần. Ghi mỗi commit trong lịch sử repo (chỉ commitSha +
  timestamp, rẻ) — dùng để dựng timeline khi có Dispute sau này
  (xem docs/plagiarism-detection-plan.md).
end note
GameSvc -> CommitRepo: save(SourceCommit) cho từng commit\ntrong lịch sử repo

GameSvc -> AiSvc: reviewGameAsync(gameId)\n(sau khi transaction commit)
note right: AI review: code quality, media match,\nNSFW, description match (ai-review-plan.md)

GameSvc --> FE: Game.status = pending
FE --> Dev: Đã nộp — chờ admin đánh giá

== Rẽ nhánh theo publishingType ==

alt 2.1 — Marketplace (bán source code, publishingType = marketplace_listing)

  Admin -> GameCtrl: Vào Admin Dashboard, xem Game pending
  GameCtrl --> Admin: Hiện thông tin game +\nAI report (code quality, media match, NSFW)\n+ Plagiarism flags (nếu có)

  Admin -> GameSvc: Xem xét, quyết định
  alt Admin từ chối
    GameSvc -> GameSvc: game.status = rejected
    GameSvc --> Dev: Thông báo từ chối (lý do)
  else Admin duyệt
    GameSvc -> GameSvc: game.status = approved
    GameSvc --> Dev: Game lên Marketplace — buyer\ncó thể mua source code
  end

else 2.2 — To Store (full_acquisition / co_publishing)

  Admin -> ContractSvc: createOffer(gameId, contractType,\nrevenueSplit/lumpSumAmount, adminSignature)
  note right of ContractSvc
    Contract 1:1 với Game — admin ký ngay lúc tạo offer
    (buyerSignature bắt buộc, xem Contract.java)
  end note
  ContractSvc -> ContractSvc: contract.status = pending
  ContractSvc --> Dev: Email thông báo — có hợp đồng chờ ký

  Dev -> ContractSvc: Xem điều khoản hợp đồng
  alt Developer từ chối hợp đồng
    Dev -> ContractSvc: rejectByDeveloper(contractId, rejectionReason)
    ContractSvc -> ContractSvc: contract.rejectionReason = reason\n(sửa TRỰC TIẾP row này — không tạo row mới)
    ContractSvc -> ContractSvc: game.status = pending (chờ admin\nchào lại điều khoản khác)
    ContractSvc --> Admin: Thông báo — dev từ chối kèm lý do
    Admin -> ContractSvc: createOffer(...) — chào lại điều khoản mới\n(ghi đè lên contract hiện tại)
    note right: Lặp lại tới khi dev ký hoặc admin dừng đàm phán
  else Developer đồng ý, ký hợp đồng
    Dev -> ContractSvc: signByDeveloper(contractId, sellerSignature,\nsellerRepresentative, sellerAddress, sellerTaxCode)
    ContractSvc -> ContractSvc: contract.sellerSignatureBase64 = ...\ncontract.signedAtSeller = now\ncontract.status = signed

    note over ContractSvc, GPAPI #DDFFDD
      **Ký xong KHÔNG publish ngay** — chỉ tự động MỞ RA bước
      tiếp theo: hệ thống hiện tính năng "Upload build" cho admin.
      Admin vẫn phải tự build APK/AAB (Godot export, thủ công,
      ngoài hệ thống) rồi UPLOAD file lên thì mới kích hoạt được
      luồng API tự động (UPLOAD + LISTING + SUBMIT lên Google Play
      qua androidpublisher).

      **App phải được TẠO THỦ CÔNG 1 LẦN trong Play Console trước**
      (chọn package name, category, content rating questionnaire,
      data safety form, privacy policy URL) — androidpublisher API
      KHÔNG có endpoint tạo app mới, các bước này Google không cho
      tự động hoá qua API công khai. Từ sau bước tạo app thủ công
      đó trở đi, mọi lần release version mới đều tự động.
    end note

    ContractSvc -> GameSvc: ExternalPublish.status = pending\n(chờ admin build + upload)
    GameSvc --> Admin: Thông báo — hợp đồng đã ký,\ntính năng "Upload build" đã sẵn sàng

    Admin -> Admin: Export APK/AAB từ Godot Editor\n(thủ công, ngoài hệ thống)
    Admin -> FE: Vào tính năng "Upload build"\nchọn file APK/AAB + version number + changelog\n+ shortDescription (≤80 ký tự) + feature graphic (1024x500)
    note right of FE
      title/fullDescription/icon/screenshots lấy tự động từ
      Game entity + Media có sẵn (không cần nhập lại) — nhưng
      shortDescription và feature graphic là asset RIÊNG cho Play
      Store, Game entity không có sẵn nên bắt buộc nhập ở đây.
      Validate trước khi gọi Google Play: game phải có thumbnail
      (dùng làm icon) và tối thiểu 2 screenshot.
    end note
    FE -> GPSvc: publishGameToStore(gameId, buildFile,\nshortDescription, featureGraphic)
    note right of GPSvc: Từ đây trở đi, MỌI bước là tự động\nqua Google Play Developer API

    GPSvc -> GPAPI: POST /edits — tạo edit session
    GPAPI --> GPSvc: editId

    GPSvc -> GPAPI: PUT /edits/{editId}/bundles\n(upload file AAB)
    GPAPI --> GPSvc: versionCode

    GPSvc -> GPAPI: PUT /edits/{editId}/listings/{lang}\n(title, shortDescription, fullDescription)
    GPAPI --> GPSvc: OK

    GPSvc -> GPAPI: POST /edits/{editId}/listings/{lang}/images/icon\nPOST .../images/featureGraphic\nPOST .../images/phoneScreenshots (mỗi screenshot 1 lần)
    GPAPI --> GPSvc: OK

    GPSvc -> GPAPI: PUT /edits/{editId}/details\n(contactEmail của developer, defaultLanguage)
    GPAPI --> GPSvc: OK

    GPSvc -> GPAPI: PUT /edits/{editId}/tracks/{track}\n{releases: [{versionCodes: [versionCode], status: "completed"}]}
    note right of GPAPI #FFDDDD
      **BẮT BUỘC** — gán versionCode vừa upload vào 1 release
      track (production/internal/...). Thiếu bước này thì
      commit vẫn "thành công" nhưng KHÔNG release version nào
      cả, Google Play không đẩy bản build mới cho user.
    end note
    GPAPI --> GPSvc: OK

    GPSvc -> GPAPI: POST /edits/{editId}:commit
    GPAPI --> GPSvc: kết quả commit

    GPSvc -> GameSvc: tạo/cập nhật ExternalPublish\n{game, gameVersion, externalAppId,\nstoreUrl, status=submitted, submittedAt=now}
    GPSvc --> FE: Đã nộp lên Google Play — chờ Google duyệt
    FE --> Admin: Đã submit — trạng thái "submitted"

    note over GPSvc, GPAPI #FFDDDD
      **Google Play KHÔNG có webhook cho kết quả review.**
      Phải POLLING định kỳ (cronjob, VD mỗi 30-60 phút)
      gọi API kiểm tra trạng thái review của edit/app.
    end note

    loop Polling định kỳ (cronjob) cho tới khi có KẾT QUẢ CUỐI
      GPSvc -> GPAPI: GET /edits/{editId}/bundles\n(hoặc Publishing API review status)
      GPAPI --> GPSvc: trạng thái review hiện tại

      alt Google Play từ chối
        GPSvc -> GameSvc: ExternalPublish.status = rejected\nExternalPublish.rejectedReason = ...
        GPSvc --> Admin: Thông báo — Google Play từ chối app
        break
          note right of GPSvc: Có kết quả cuối -> DỪNG polling
        end
      else Google Play duyệt, lên live
        GPSvc -> GameSvc: ExternalPublish.status = live\nExternalPublish.liveAt = now\nExternalPublish.storeUrl = link Play Store
        GPSvc -> GameSvc: game.status = published
        GPSvc --> Dev: Thông báo — game đã live trên Google Play
        break
          note right of GPSvc: Có kết quả cuối -> DỪNG polling
        end
      else Vẫn đang review (chưa có kết quả)
        GPSvc -> GPSvc: chưa đổi gì
        note right of GPSvc: Không break -> vòng loop tiếp tục,\nchờ tới lượt polling kế tiếp
      end
    end
  end
end

@enduml
