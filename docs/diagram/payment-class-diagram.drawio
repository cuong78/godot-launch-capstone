        <!-- Gateway contract, adapter, and external SDK -->
        <mxCell id="gateway-payment" value="&lt;div align=&quot;center&quot;&gt;«interface»&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PaymentGateway&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;center&quot;&gt;&amp;lt;&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ createPayment(request: PaymentGatewayCreateRequest): PaymentGatewayCreateResponse&lt;br&gt;+ getPaymentStatus(orderCode: Long): PaymentGatewayStatusResponse&lt;br&gt;+ cancelPayment(orderCode: Long): PaymentGatewayStatusResponse&lt;br&gt;+ verifyWebhook(payload: Object): PaymentGatewayWebhookResult&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;overflow=fill;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
