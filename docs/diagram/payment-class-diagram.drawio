        <!-- Service contract and implementation -->
        <mxCell id="service-payment" value="&lt;div align=&quot;center&quot;&gt;«interface»&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;PaymentService&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;hr&gt;&lt;div align=&quot;center&quot;&gt;&amp;lt;&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;+ createPayOSPayment(request: CreatePaymentRequest, buyerEmail: String): PaymentResponse&lt;br&gt;+ createTopUpPayment(request: CreateTopUpRequest, buyerEmail: String): PaymentResponse&lt;br&gt;+ confirmPayment(paymentId: UUID, requesterEmail: String): PaymentResponse&lt;br&gt;+ cancelPayment(paymentId: UUID, requesterEmail: String): PaymentResponse&lt;br&gt;+ handleWebhook(payload: Object): PaymentResponse&lt;br&gt;+ getCurrentUserPayments(requesterEmail: String): List&amp;lt;PaymentResponse&amp;gt;&lt;br&gt;+ getPaymentByOrder(orderId: UUID, requesterEmail: String): PaymentResponse&lt;br&gt;+ getPaymentById(paymentId: UUID, requesterEmail: String): PaymentResponse&lt;br&gt;+ getPaymentStatus(orderId: UUID, requesterEmail: String): PaymentStatusSummaryResponse&lt;br&gt;+ getAdminPayments(): List&amp;lt;PaymentResponse&amp;gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;overflow=fill;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
